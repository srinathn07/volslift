# Copy to .env.local. Never commit .env.local.
# Real values are shared out of band, not in this repo.
#
# A Codex cloud environment needs these configured as secrets before it can
# verify anything that touches the database. Set them up at hour zero, not at
# hour 20.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Rendered timezone. Knoxville is Eastern. Do not change.
NEXT_PUBLIC_TZ=America/New_York

# ---------------------------------------------------------------------------
# No service-role key, on purpose.
#
# Run the migration and the seed through the Supabase dashboard SQL editor
# rather than from a script. The dashboard is already authenticated, so the
# project never needs a service-role key in a file, in the repo, or in a chat
# window. There is no code path in this build that requires one.
#
# This project uses the newer publishable key format (sb_publishable_...).
# It is designed to ship in the client bundle and is safe to expose. What makes
# it safe is RLS, nothing else. A table with RLS off is world-readable and
# world-writable to anyone holding this key, which is why the RLS work in C1 is
# a correctness requirement and not a nice-to-have.
#
# Before C1 is marked green: confirm RLS is enabled on every one of the ten
# tables, including the ones nothing uses until C8.
# ---------------------------------------------------------------------------
